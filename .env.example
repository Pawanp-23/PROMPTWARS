# Copy to .env and fill in. Never commit .env.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides
# Comma-separated, tried in order on overload
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-2.5-flash-lite
GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-2.5-flash-preview-tts
# Optional: Google Cloud service-account JSON (one line) to save summaries in Firestore.
# Without it, saved summaries live in memory.
FIRESTORE_SERVICE_ACCOUNT=
PORT=8080
